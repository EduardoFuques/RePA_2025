# Configuración de Base de Datos
# Para desarrollo local, usar localhost
# Para Docker, usar "db" como host
DATABASE_URL=postgresql://postgres:postgres@db:5432/repa_db

# CORS Origins (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Secret (cambiar en producción - usar: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production

# Entorno: development | production | testing
# En production, el seed NO carga datos de prueba
ENVIRONMENT=development

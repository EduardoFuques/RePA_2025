# =============================================================================
# RePA 2025 - Configuración de Entorno
# =============================================================================
# Copiar este archivo como .env y configurar los valores según el entorno
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# ENTORNO
# -----------------------------------------------------------------------------
# Valores: development | production | testing
# En production, el seed NO carga datos de prueba
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# Para desarrollo local con Docker: db
# Para desarrollo local sin Docker: localhost
# Para producción: usar el host real
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=exampledb
POSTGRES_PORT=5432
POSTGRES_DBHOST=db

# URL completa de conexión (usada por el backend)
DATABASE_URL=postgresql://postgres:example@db:5432/exampledb

# -----------------------------------------------------------------------------
# BACKEND - JWT / AUTENTICACIÓN
# -----------------------------------------------------------------------------
# IMPORTANTE: En producción, generar una clave segura con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# Tiempos de expiración de tokens (en minutos)
ACCESS_TOKEN_EXPIRE=30
REFRESH_TOKEN_EXPIRE=10080

# -----------------------------------------------------------------------------
# BACKEND - CORS
# -----------------------------------------------------------------------------
# Orígenes permitidos (separados por coma)
# En producción, cambiar a los dominios específicos
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# -----------------------------------------------------------------------------
# BACKEND - LOGGING
# -----------------------------------------------------------------------------
# Ruta para logs (relativa al directorio de trabajo)
LOGS_PATH=./logs
BETTER_STACKTRACE=true

# -----------------------------------------------------------------------------
# BACKEND - URLs
# -----------------------------------------------------------------------------
URL_SITE=http://localhost:8000

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# =============================================================================
# RePA 2025 - Configuración de Entorno
# =============================================================================
# Copiar este archivo como .env y configurar los valores según el entorno
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# ENTORNO
# -----------------------------------------------------------------------------
# Valores: development | production | testing
# En production, el seed NO carga datos de prueba
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# Para desarrollo local con Docker: db
# Para desarrollo local sin Docker: localhost
# Para producción: usar el host real
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=exampledb
POSTGRES_PORT=5432
POSTGRES_DBHOST=db

# URL completa de conexión (usada por el backend)
DATABASE_URL=postgresql://postgres:example@db:5432/exampledb

# -----------------------------------------------------------------------------
# BACKEND - JWT / AUTENTICACIÓN
# -----------------------------------------------------------------------------
# IMPORTANTE: En producción, generar una clave segura con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# Tiempos de expiración de tokens (en minutos)
ACCESS_TOKEN_EXPIRE=30
REFRESH_TOKEN_EXPIRE=10080

# -----------------------------------------------------------------------------
# BACKEND - CORS
# -----------------------------------------------------------------------------
# Orígenes permitidos (separados por coma)
# En producción, cambiar a los dominios específicos
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# -----------------------------------------------------------------------------
# BACKEND - LOGGING
# -----------------------------------------------------------------------------
# Ruta para logs (relativa al directorio de trabajo)
LOGS_PATH=./logs
BETTER_STACKTRACE=true

# -----------------------------------------------------------------------------
# BACKEND - URLs
# -----------------------------------------------------------------------------
URL_SITE=http://localhost:8000

# URL pública del FRONTEND — se usa para armar los links de confirmación de
# cuenta y recuperación de contraseña que van en los emails.
FRONTEND_URL=http://localhost:5173

# Root path para la API (usado cuando está detrás de un proxy reverso)
# En desarrollo local: dejar vacío ""
# En producción con nginx proxy en /api: "/api"
API_ROOT_PATH=

# -----------------------------------------------------------------------------
# HTTPS (solo VPS con certificado real — ver docker-compose.ssl.yml)
# -----------------------------------------------------------------------------
# Dominio con certificado Let's Encrypt en
# /etc/letsencrypt/live/$SSL_DOMAIN/{fullchain,privkey}.pem — deploy.sh lo
# agrega solo si detecta el certificado ahí. Dejar vacío si este servidor
# no tiene HTTPS propio (p. ej. TLS terminado en otro lado, o dev local).
SSL_DOMAIN=

# -----------------------------------------------------------------------------
# BACKEND - Pool de conexiones de base de datos
# -----------------------------------------------------------------------------
# Para ~300 usuarios concurrentes: pool_size=20 + max_overflow=30 = 50 conexiones máx
# PostgreSQL default max_connections=100, así que 50 deja margen para admin/backups
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30000

# -----------------------------------------------------------------------------
# BACKEND - EMAIL TRANSACCIONAL (verificación de cuenta, recuperación de contraseña)
# -----------------------------------------------------------------------------
# Sin SMTP_HOST configurado, el backend NO envía emails reales (solo loguea
# un warning) — en desarrollo/testing esto no bloquea nada porque el token
# se devuelve directamente en la respuesta de la API. En PRODUCCIÓN es
# obligatorio: sin esto, un usuario nuevo no puede activar su cuenta ni
# recuperar su contraseña.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@iaavim.gob.ar
SMTP_USE_TLS=true
# SSL implícito (puerto 465, ej. Mailosaur) en vez de STARTTLS (puerto 587).
# Si se activa, SMTP_USE_TLS se ignora (son mutuamente excluyentes).
SMTP_USE_SSL=false

# -----------------------------------------------------------------------------
# BACKUP DE BASE DE DATOS
# -----------------------------------------------------------------------------
# Directorio donde se guardan los backups
BACKUP_DIR=/var/backups/repa
# Días de retención de backups (los más antiguos se eliminan automáticamente)
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ===========================================
# Datos de contacto / redes de la landing pública (build-time del frontend)
# ===========================================
# El docker-compose los pasa como build args al frontend. Si se dejan sin
# definir, la landing usa los fallbacks de frontend/src/config/site.js.
VITE_CONTACT_EMAIL=info@iaavim.gob.ar
VITE_CONTACT_PHONE=+54 (376) 442-1234
VITE_CONTACT_WHATSAPP=543764442123
VITE_CONTACT_WHATSAPP_LABEL=Escribinos por WhatsApp
VITE_SOCIAL_INSTAGRAM=https://instagram.com/iaavim
VITE_SOCIAL_FACEBOOK=https://facebook.com/iaavim
VITE_CONTACT_SEDE=Posadas, Misiones
VITE_CONTACT_PORTAL=misiones.gob.ar
VITE_CONTACT_PORTAL_URL=https://misiones.gob.ar
